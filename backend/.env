# Valores padrão versionados. Sobrescreva em .env.local (não versionado)
# ou com variáveis de ambiente reais. Nunca coloque segredos de produção aqui.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-secret-change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8080

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://forno:forno@database:5432/forno?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

REDIS_URL=redis://redis:6379

# Permite que novos estabelecimentos se cadastrem pela tela pública.
FORNO_REGISTRATION_ENABLED=1
